# Telegram bot token from @BotFather
BOT_TOKEN=1234567890:replace-with-your-real-bot-token

# Telegram API credentials from https://my.telegram.org/apps
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Public HTTPS origin of this very server. Telegram refuses non-HTTPS WebApp URLs.
SERVER_URL=https://your-domain.example.com

# HTTP port (inside and outside the container)
PORT=3000

# ---- Optional overrides (sane defaults are built in) ----
# Public URL users are redirected to after a successful login
REDIRECT_URL=https://your-domain.example.com
# Where session files + the session index are written (mounted as a Docker volume)
DATA_DIR=./data
# Number of reverse-proxy hops in front of this server (1 = Cloudflare/nginx).
# Avoid `true`: it trusts every X-Forwarded-For entry and lets clients spoof their IP.
TRUST_PROXY=1
# log level: debug | info | warn | error
LOG_LEVEL=info
# Login flow tuning
# OTP_TTL_MS=600000
# OTP_MAX_ATTEMPTS=5
# RESEND_COOLDOWN_MS=60000
# Local development only: allow http:// in SERVER_URL/REDIRECT_URL. Never in production.
# ALLOW_INSECURE_SERVER_URL=1
